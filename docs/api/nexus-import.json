									"example": "\"3fa85f64-5717-4562-b3fc-2c963f66afa6\""
								},
								{
									"key": "data[].message",
									"type": "string",
									"desc": "Текст сообщения",
									"example": "\"hello world\""
								},
								{
									"key": "data[].created_at",
									"type": "datetime",
									"desc": "Дата создания",
									"example": "\"2026-06-01T10:00:00Z\""
								},
								{
									"key": "data[].updated_at",
									"type": "datetime",
									"desc": "Дата обновления",
									"example": "\"2026-06-01T10:00:00Z\""
								},
								{
									"key": "pagination.total",
									"type": "integer",
									"desc": "Всего записей",
									"example": "42"
								},
								{
									"key": "pagination.page",
									"type": "integer",
									"desc": "Текущая страница",
									"example": "1"
