{
	"doc": {
		"name": "Nexus Service API",
		"version": "v1",
		"desc": "REST API сервиса Nexus: временные ссылки на файлы (FileShare) и общий буфер обмена (Clipboard). Хранилище — SQLite, файлы — локальная ФС. Аутентификация отсутствует.",
		"tags": ["REST", "JSON", "No auth", "SQLite"]
	},
	"groups": [
		{
			"label": "Health",
			"endpoints": [
				{
					"method": "GET",
					"path": "/health",
					"name": "Health check",
					"description": "Liveness/readiness проба. Всегда возвращает 200 OK, если сервис запущен. Находится вне префикса /api/v1.",
					"tags": ["public"],
					"auth": false,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "name",
									"type": "string",
									"desc": "Имя сервиса",
									"example": "\"nexus\""
								},
								{
									"key": "status",
									"type": "string",
									"desc": "Статус сервиса",
									"example": "\"ok\""
								}
							],
							"example": "{\n  \"name\": \"nexus\",\n  \"status\": \"ok\"\n}"
						}
					}
				}
			]
		},
		{
			"label": "Clipboards",
			"endpoints": [
				{
					"method": "POST",
					"path": "/clipboards",
					"name": "Создать запись буфера",
					"description": "Создаёт новую запись буфера обмена с текстовым сообщением. Ответ обёрнут в объект `data`.",
					"tags": ["public"],
					"auth": false,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "message",
							"type": "string",
							"required": true,
							"desc": "Текст сообщения. Не может быть пустым.",
							"default": ""
						}
					],
					"responses": {
						"201": {
							"label": "201 Created",
							"schema": [
								{
									"key": "data.id",
									"type": "string",
									"desc": "Идентификатор записи (uuid-подобный)",
									"example": "\"3fa85f64-5717-4562-b3fc-2c963f66afa6\""
								},
								{
									"key": "data.message",
									"type": "string",
									"desc": "Текст сообщения",
									"example": "\"hello world\""
								},
								{
									"key": "data.created_at",
									"type": "datetime",
									"desc": "Дата создания (RFC3339)",
									"example": "\"2026-06-01T10:00:00Z\""
								},
								{
									"key": "data.updated_at",
									"type": "datetime",
									"desc": "Дата обновления (RFC3339)",
									"example": "\"2026-06-01T10:00:00Z\""
								}
							],
							"example": "{\n  \"data\": {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"message\": \"hello world\",\n    \"created_at\": \"2026-06-01T10:00:00Z\",\n    \"updated_at\": \"2026-06-01T10:00:00Z\"\n  }\n}"
						},
						"400": {
							"label": "400 Bad Request",
							"schema": [
								{
									"key": "code",
									"type": "string",
									"desc": "Категория ошибки",
									"example": "\"Bad Request\""
								},
								{
									"key": "message",
									"type": "string",
									"desc": "Описание ошибки (пустое сообщение или невалидный JSON)",
									"example": "\"invalid message\""
								}
							],
							"example": "{\n  \"code\": \"Bad Request\",\n  \"message\": \"invalid message\"\n}"
						}
					}
				},
				{
