							],
							"example": "{\n  \"data\": [\n    {\n      \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n      \"message\": \"hello world\",\n      \"created_at\": \"2026-06-01T10:00:00Z\",\n      \"updated_at\": \"2026-06-01T10:00:00Z\"\n    }\n  ],\n  \"pagination\": {\n    \"total\": 42,\n    \"page\": 1,\n    \"limit\": 20,\n    \"total_pages\": 3\n  }\n}"
						}
					}
				},
