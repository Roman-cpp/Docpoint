		{
			"label": "Files",
			"endpoints": [
				{
					"method": "POST",
					"path": "/files",
					"name": "Загрузить файл",
					"description": "Загружает файл и создаёт временную ссылку для скачивания. Запрос в формате multipart/form-data. Максимальный размер файла — 100 MB. Объект FileShare отдаётся без обёртки `data`.",
					"tags": ["public", "multipart"],
					"auth": false,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "file",
							"type": "object",
							"required": true,
							"desc": "Файл (multipart field), макс. 100 MB",
							"default": ""
						},
						{
							"name": "expires_at",
							"type": "datetime",
							"required": false,
							"desc": "Срок жизни ссылки в формате RFC3339. Без значения — бессрочно.",
							"default": ""
						},
						{
							"name": "max_downloads",
							"type": "integer",
							"required": false,
							"desc": "Лимит скачиваний, целое число > 0. Без значения — без лимита.",
							"default": ""
						}
					],
					"responses": {
						"201": {
							"label": "201 Created",
							"schema": [
								{
									"key": "id",
									"type": "string",
									"desc": "Идентификатор файла",
									"example": "\"a1b2c3d4-e5f6-7890-abcd-ef1234567890\""
								},
								{
									"key": "file_name",
									"type": "string",
									"desc": "Оригинальное имя файла",
									"example": "\"report.pdf\""
								},
								{
									"key": "size",
									"type": "integer",
									"desc": "Размер в байтах",
									"example": "204800"
								},
								{
									"key": "content_type",
									"type": "string",
									"desc": "MIME-тип",
									"example": "\"application/pdf\""
								},
								{
									"key": "token",
									"type": "string",
									"desc": "Публичный токен для скачивания",
									"example": "\"3f8a1c2e9d4b7a6f0e5c2d1b8a9f4e3c\""
								},
								{
									"key": "expires_at",
									"type": "datetime",
									"desc": "Срок жизни ссылки (опускается, если null)",
									"example": "\"2026-06-08T12:00:00Z\""
								},
								{
									"key": "max_downloads",
									"type": "integer",
									"desc": "Лимит скачиваний (опускается, если null)",
									"example": "5"
								},
								{
									"key": "downloads",
									"type": "integer",
									"desc": "Счётчик скачиваний",
									"example": "0"
								},
								{
									"key": "created_at",
									"type": "datetime",
									"desc": "Дата загрузки",
									"example": "\"2026-06-01T10:00:00Z\""
								}
							],
							"example": "{\n  \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"file_name\": \"report.pdf\",\n  \"size\": 204800,\n  \"content_type\": \"application/pdf\",\n  \"token\": \"3f8a1c2e9d4b7a6f0e5c2d1b8a9f4e3c\",\n  \"expires_at\": \"2026-06-08T12:00:00Z\",\n  \"max_downloads\": 5,\n  \"downloads\": 0,\n  \"created_at\": \"2026-06-01T10:00:00Z\"\n}"
						},
						"400": {
							"label": "400 Bad Request",
							"schema": [
								{
									"key": "code",
									"type": "string",
									"desc": "Категория ошибки",
									"example": "\"Bad Request\""
								},
								{
									"key": "message",
									"type": "string",
									"desc": "Невалидный multipart, отсутствует поле file, неверный expires_at/max_downloads или пустое имя файла",
									"example": "\"invalid expires_at: use RFC3339 format\""
								}
							],
							"example": "{\n  \"code\": \"Bad Request\",\n  \"message\": \"invalid expires_at: use RFC3339 format\"\n}"
						},
						"413": {
							"label": "413 Request Entity Too Large",
							"schema": [
								{
									"key": "code",
									"type": "string",
									"desc": "Категория ошибки",
									"example": "\"Request Entity Too Large\""
								},
								{
									"key": "message",
									"type": "string",
									"desc": "Файл превышает 100 MB",
									"example": "\"fileshare: file too large\""
								}
							],
							"example": "{\n  \"code\": \"Request Entity Too Large\",\n  \"message\": \"fileshare: file too large\"\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/files",
					"name": "Список файлов",
					"description": "Возвращает постраничный список загруженных файлов.",
					"tags": ["public", "paginated"],
					"auth": false,
					"queryParams": [
						{
							"name": "page",
							"type": "integer",
							"required": false,
							"desc": "Номер страницы (>= 1)",
							"default": "1"
						},
						{
							"name": "limit",
							"type": "integer",
							"required": false,
							"desc": "Размер страницы (>= 1)",
							"default": "20"
						}
					],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "data[].id",
									"type": "string",
									"desc": "Идентификатор файла",
									"example": "\"a1b2c3d4-e5f6-7890-abcd-ef1234567890\""
								},
								{
									"key": "data[].file_name",
									"type": "string",
									"desc": "Имя файла",
									"example": "\"report.pdf\""
								},
								{
									"key": "data[].size",
									"type": "integer",
									"desc": "Размер в байтах",
									"example": "204800"
								},
								{
									"key": "data[].content_type",
									"type": "string",
									"desc": "MIME-тип",
									"example": "\"application/pdf\""
								},
								{
									"key": "data[].token",
									"type": "string",
									"desc": "Токен скачивания",
									"example": "\"3f8a1c2e9d4b7a6f0e5c2d1b8a9f4e3c\""
								},
								{
									"key": "data[].downloads",
									"type": "integer",
									"desc": "Счётчик скачиваний",
									"example": "2"
								},
								{
									"key": "data[].created_at",
									"type": "datetime",
									"desc": "Дата загрузки",
									"example": "\"2026-06-01T10:00:00Z\""
								},
								{
									"key": "pagination.total",
									"type": "integer",
									"desc": "Всего файлов",
									"example": "42"
								},
								{
									"key": "pagination.page",
									"type": "integer",
									"desc": "Текущая страница",
									"example": "1"
								},
								{
									"key": "pagination.limit",
									"type": "integer",
									"desc": "Размер страницы",
									"example": "20"
								},
								{
									"key": "pagination.total_pages",
									"type": "integer",
									"desc": "Всего страниц",
									"example": "3"
								}
							],
							"example": "{\n  \"data\": [\n    {\n      \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n      \"file_name\": \"report.pdf\",\n      \"size\": 204800,\n      \"content_type\": \"application/pdf\",\n      \"token\": \"3f8a1c2e9d4b7a6f0e5c2d1b8a9f4e3c\",\n      \"downloads\": 2,\n      \"created_at\": \"2026-06-01T10:00:00Z\"\n    }\n  ],\n  \"pagination\": {\n    \"total\": 42,\n    \"page\": 1,\n    \"limit\": 20,\n    \"total_pages\": 3\n  }\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/files/dl/{token}",
					"name": "Скачать файл",
