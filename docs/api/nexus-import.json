							"example": "{\n  \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"message\": \"updated text\",\n  \"created_at\": \"2026-06-01T10:00:00Z\",\n  \"updated_at\": \"2026-06-01T11:30:00Z\"\n}"
						},
