  "groups": [
    {
      "label": "Auth",
      "endpoints": [
        {
          "method": "POST",
          "path": "/auth/login",
          "name": "Login",
          "description": "Аутентификация пользователя. Возвращает Bearer-токен для последующих запросов.",
          "auth": false,
          "queryParams": [],
          "body": {
            "email": "<email>",
            "password": "<password>"
          },
          "bodyFields": [
            {
              "path": "email",
              "desc": "Email пользователя",
              "required": true
            },
            {
              "path": "password",
              "desc": "Пароль (мин. 8 символов)",
              "required": true
            }
          ],
          "responses": {
            "200": {
              "label": "200 OK",
              "body": {
                "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                "expires_in": 3600
              },
              "fields": [
                {
                  "path": "token",
                  "desc": "JWT Bearer-токен"
                },
                {
                  "path": "expires_in",
                  "desc": "Срок жизни токена в секундах",
                  "format": "integer"
                }
              ]
            },
            "401": {
              "label": "401 Unauthorized",
              "body": {
                "message": "Invalid credentials"
              },
              "fields": [
                {
                  "path": "message",
                  "desc": "Описание ошибки"
                }
              ]
            }
          },
          "requests": [
            {
              "name": "Валидные учётные данные",
              "body": {
                "email": "admin@example.com",
                "password": "correct-horse-battery"
              }
            },
            {
              "name": "Неверный пароль — ждём 401",
              "body": {
                "email": "admin@example.com",
                "password": "wrong"
              }
            }
          ]
        },
        {
          "method": "POST",
          "path": "/auth/logout",
          "name": "Logout",
          "description": "Инвалидирует текущий Bearer-токен пользователя.",
          "auth": true,
          "queryParams": [],
          "responses": {
            "204": {
              "label": "204 No Content"
            }
          }
        }
      ]
    },
    {
