	"groups": [
		{
			"label": "Auth",
			"endpoints": [
				{
					"method": "POST",
					"path": "/auth/login",
					"name": "Login",
					"description": "Аутентификация пользователя. Возвращает Bearer-токен для последующих запросов.",
					"auth": false,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "email",
							"type": "string",
							"required": true,
							"desc": "Email пользователя",
							"default": ""
						},
						{
							"name": "password",
							"type": "string",
							"required": true,
							"desc": "Пароль (мин. 8 символов)",
							"default": ""
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "token",
									"type": "string",
									"desc": "JWT Bearer-токен",
									"example": "\"eyJhbGci...\""
								},
								{
									"key": "expires_in",
									"type": "integer",
									"desc": "Срок жизни токена в секундах",
									"example": "3600"
								}
							],
							"example": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"expires_in\": 3600\n}"
						},
						"401": {
							"label": "401 Unauthorized",
							"schema": [
								{
									"key": "message",
									"type": "string",
									"desc": "Описание ошибки",
									"example": "\"Invalid credentials\""
								}
							],
							"example": "{\n  \"message\": \"Invalid credentials\"\n}"
						}
					},
					"requests": [
						{
							"name": "Валидные учётные данные",
							"body": {
								"email": "admin@example.com",
								"password": "correct-horse-battery"
							}
						},
						{
							"name": "Неверный пароль — ждём 401",
							"body": {
								"email": "admin@example.com",
								"password": "wrong"
							}
						}
					]
				},
				{
					"method": "POST",
					"path": "/auth/logout",
					"name": "Logout",
					"description": "Инвалидирует текущий Bearer-токен пользователя.",
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"204": {
							"label": "204 No Content",
							"schema": [],
							"example": ""
						}
					}
				}
			]
		},
		{
			"label": "Users",
			"endpoints": [
				{
					"method": "GET",
					"path": "/users",
					"name": "List users",
					"description": "Возвращает постраничный список пользователей. Доступно только администраторам.",
					"auth": true,
					"queryParams": [
						{
							"name": "page",
							"type": "integer",
							"required": false,
							"desc": "Номер страницы",
							"default": "1"
						},
						{
							"name": "limit",
							"type": "integer",
							"required": false,
							"desc": "Элементов на странице",
							"default": "20"
						},
						{
							"name": "search",
							"type": "string",
							"required": false,
							"desc": "Фильтр по имени или email",
							"default": ""
						}
					],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "data[].id",
									"type": "uuid",
									"desc": "UUID пользователя",
									"example": "\"3fa85f64-5717-4562-b3fc-2c963f66afa6\""
								},
								{
									"key": "data[].name",
									"type": "string",
									"desc": "Полное имя",
									"example": "\"Alice Smith\""
								},
								{
									"key": "data[].email",
									"type": "string",
									"desc": "Email",
									"example": "\"alice@example.com\""
								},
								{
									"key": "data[].role",
									"type": "string",
									"desc": "Роль пользователя",
									"example": "\"member\""
								},
								{
									"key": "meta.total",
									"type": "integer",
									"desc": "Всего записей",
									"example": "142"
								},
								{
									"key": "meta.page",
									"type": "integer",
									"desc": "Текущая страница",
									"example": "1"
								}
							],
							"example": "{\n  \"data\": [\n    { \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\", \"name\": \"Alice Smith\", \"email\": \"alice@example.com\", \"role\": \"member\" }\n  ],\n  \"meta\": { \"total\": 142, \"page\": 1 }\n}"
						}
					},
					"requests": [
						{
							"name": "Первая страница",
							"query": {
								"page": 1,
								"limit": 20
							},
							"headers": {
								"X-Request-Id": "smoke-users-page-1"
							}
						},
						{
							"name": "Поиск по имени",
							"query": {
								"search": "ivan",
								"limit": 5
							}
						}
					]
				},
