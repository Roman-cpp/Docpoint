									"desc": "UUID задачи"
								},
								{
									"key": "data[].title",
									"type": "string",
									"desc": "Заголовок задачи"
								},
								{
									"key": "data[].status",
									"type": "string",
									"desc": "Статус: todo / in_progress / done"
								},
								{
									"key": "data[].priority",
									"type": "string",
