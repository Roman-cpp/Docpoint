		{
			"label": "Tasks",
			"endpoints": [
				{
					"method": "GET",
					"path": "/tasks",
					"name": "List tasks",
					"description": "Возвращает задачи текущего пользователя. Можно фильтровать по статусу и проекту.",
					"auth": true,
					"queryParams": [
						{
							"name": "status",
							"type": "string",
							"required": false,
							"desc": "Фильтр по статусу: todo / in_progress / done",
							"default": ""
						},
						{
							"name": "project_id",
							"type": "uuid",
							"required": false,
							"desc": "Фильтр по проекту",
							"default": ""
						},
						{
							"name": "page",
							"type": "integer",
							"required": false,
							"desc": "Номер страницы",
							"default": "1"
						},
						{
							"name": "limit",
							"type": "integer",
							"required": false,
							"desc": "Элементов на странице",
							"default": "20"
