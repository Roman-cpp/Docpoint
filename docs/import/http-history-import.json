{
	"doc": {
		"name": "HTTP History Service",
		"version": "v1",
		"desc": "Микросервис приёма и хранения истории HTTP-запросов. Мультитенантный: история ведётся отдельно для каждого зарегистрированного сервиса-источника и его окружений.",
		"tags": ["REST", "JSON", "Observability", "Multi-tenant", "Auth required"]
	},
	"groups": [
		{
			"label": "Services",
			"endpoints": [
				{
					"method": "GET",
					"path": "/services",
					"name": "List services",
					"description": "Возвращает список зарегистрированных сервисов-источников, история которых хранится. Доступно администраторам.",
					"tags": ["paginated", "admin"],
					"auth": true,
					"queryParams": [
						{
							"name": "page",
							"type": "integer",
							"required": false,
							"desc": "Номер страницы",
							"default": "1"
						},
						{
							"name": "limit",
							"type": "integer",
							"required": false,
							"desc": "Элементов на странице",
							"default": "20"
						},
						{
							"name": "is_active",
							"type": "boolean",
							"required": false,
							"desc": "Фильтр по активности источника",
							"default": ""
						},
						{
							"name": "search",
							"type": "string",
							"required": false,
							"desc": "Фильтр по name или slug",
							"default": ""
						}
					],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "data[].id",
									"type": "uuid",
									"desc": "UUID сервиса",
									"example": "\"7c9e6679-7425-40de-944b-e07fc1f90ae7\""
								},
								{
									"key": "data[].slug",
									"type": "string",
									"desc": "Машинный идентификатор",
									"example": "\"billing-api\""
								},
								{
									"key": "data[].name",
									"type": "string",
									"desc": "Человекочитаемое имя",
									"example": "\"Billing API\""
								},
								{
									"key": "data[].is_active",
									"type": "boolean",
									"desc": "Принимается ли история",
									"example": "true"
								},
								{
									"key": "meta.total",
									"type": "integer",
									"desc": "Всего сервисов",
									"example": "12"
								}
							],
							"example": "{\n  \"data\": [\n    { \"id\": \"7c9e6679-7425-40de-944b-e07fc1f90ae7\", \"slug\": \"billing-api\", \"name\": \"Billing API\", \"is_active\": true }\n  ],\n  \"meta\": { \"total\": 12 }\n}"
						}
					}
				},
				{
					"method": "POST",
					"path": "/services",
					"name": "Register service",
					"description": "Регистрирует новый сервис-источник. С этого момента под его идентификатором можно принимать историю запросов.",
					"tags": ["admin"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "slug",
							"type": "string",
							"required": true,
							"desc": "Уникальный машинный идентификатор (a-z, 0-9, дефис)",
							"default": ""
						},
						{
							"name": "name",
							"type": "string",
							"required": true,
							"desc": "Человекочитаемое имя",
							"default": ""
						},
						{
							"name": "desc",
							"type": "string",
							"required": false,
							"desc": "Описание назначения сервиса",
							"default": ""
						},
						{
							"name": "base_url",
							"type": "string",
							"required": false,
							"desc": "Базовый URL сервиса (для справки)",
							"default": ""
						},
						{
							"name": "owner",
							"type": "string",
							"required": false,
							"desc": "Команда или владелец сервиса",
							"default": ""
						}
					],
					"responses": {
						"201": {
							"label": "201 Created",
							"schema": [
								{
									"key": "id",
									"type": "uuid",
									"desc": "UUID нового сервиса",
									"example": "\"7c9e6679-7425-40de-944b-e07fc1f90ae7\""
								},
								{
									"key": "slug",
									"type": "string",
									"desc": "Машинный идентификатор",
									"example": "\"billing-api\""
								}
							],
							"example": "{\n  \"id\": \"7c9e6679-7425-40de-944b-e07fc1f90ae7\",\n  \"slug\": \"billing-api\"\n}"
						},
						"422": {
							"label": "422 Validation Error",
							"schema": [
								{
									"key": "errors[].field",
									"type": "string",
									"desc": "Имя поля с ошибкой"
								},
								{
									"key": "errors[].message",
									"type": "string",
									"desc": "Описание ошибки"
								}
							],
							"example": "{\n  \"errors\": [\n    { \"field\": \"slug\", \"message\": \"Slug already taken\" }\n  ]\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/services/{id}",
					"name": "Get service",
					"description": "Возвращает карточку сервиса-источника по UUID.",
					"tags": ["admin"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{ "key": "id", "type": "uuid", "desc": "UUID сервиса" },
								{
									"key": "slug",
									"type": "string",
									"desc": "Машинный идентификатор"
								},
								{ "key": "name", "type": "string", "desc": "Имя сервиса" },
								{ "key": "desc", "type": "string", "desc": "Описание" },
								{ "key": "base_url", "type": "string", "desc": "Базовый URL" },
								{
									"key": "owner",
									"type": "string",
									"desc": "Владелец / команда"
								},
								{ "key": "is_active", "type": "boolean", "desc": "Активность" },
								{
									"key": "created_at",
									"type": "datetime",
									"desc": "Дата регистрации"
								}
							],
							"example": "{\n  \"id\": \"7c9e6679-7425-40de-944b-e07fc1f90ae7\",\n  \"slug\": \"billing-api\",\n  \"name\": \"Billing API\",\n  \"desc\": \"Сервис выставления счетов\",\n  \"base_url\": \"https://billing.internal\",\n  \"owner\": \"payments-team\",\n  \"is_active\": true,\n  \"created_at\": \"2026-01-10T09:00:00Z\"\n}"
						},
						"404": {
							"label": "404 Not Found",
							"schema": [
								{
									"key": "message",
									"type": "string",
									"desc": "Описание ошибки"
								}
							],
							"example": "{\n  \"message\": \"Service not found\"\n}"
						}
					}
				},
				{
					"method": "PATCH",
					"path": "/services/{id}",
					"name": "Update service",
					"description": "Частичное обновление карточки сервиса. Деактивация (is_active=false) останавливает приём новой истории, не удаляя накопленную.",
					"tags": ["admin"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "name",
							"type": "string",
							"required": false,
							"desc": "Новое имя",
							"default": ""
						},
						{
							"name": "desc",
							"type": "string",
							"required": false,
							"desc": "Новое описание",
							"default": ""
						},
						{
							"name": "is_active",
							"type": "boolean",
							"required": false,
							"desc": "Принимать ли новую историю",
							"default": ""
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{ "key": "id", "type": "uuid", "desc": "UUID сервиса" },
								{ "key": "is_active", "type": "boolean", "desc": "Активность" }
							],
							"example": "{\n  \"id\": \"7c9e6679-7425-40de-944b-e07fc1f90ae7\",\n  \"is_active\": false\n}"
						}
					}
				},
				{
					"method": "DELETE",
					"path": "/services/{id}",
					"name": "Delete service",
					"description": "Удаляет сервис вместе со всей его историей, окружениями, токенами и телами запросов. Необратимая операция.",
					"tags": ["admin", "destructive"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"204": {
							"label": "204 No Content",
							"schema": [],
							"example": ""
						}
					}
				}
			]
		},
		{
			"label": "Environments",
			"endpoints": [
				{
					"method": "GET",
					"path": "/services/{id}/environments",
					"name": "List environments",
					"description": "Возвращает окружения конкретного сервиса (prod / staging / local), в разрезе которых разделяется история.",
					"tags": ["admin"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "data[].id",
									"type": "uuid",
									"desc": "UUID окружения"
								},
								{
									"key": "data[].name",
									"type": "string",
									"desc": "prod / staging / local"
								},
								{
									"key": "data[].base_url",
									"type": "string",
									"desc": "Базовый URL окружения"
								}
							],
							"example": "{\n  \"data\": [\n    { \"id\": \"a1b2c3d4-0000-4000-8000-000000000001\", \"name\": \"prod\", \"base_url\": \"https://billing.internal\" }\n  ]\n}"
						}
					}
				},
				{
					"method": "POST",
					"path": "/services/{id}/environments",
					"name": "Create environment",
					"description": "Добавляет окружение к сервису. Имя окружения уникально в пределах сервиса.",
					"tags": ["admin"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "name",
							"type": "string",
							"required": true,
							"desc": "Идентификатор окружения (prod / staging / local)",
							"default": ""
						},
						{
							"name": "base_url",
							"type": "string",
							"required": false,
							"desc": "Базовый URL окружения",
							"default": ""
						}
					],
					"responses": {
						"201": {
							"label": "201 Created",
							"schema": [
								{ "key": "id", "type": "uuid", "desc": "UUID окружения" }
							],
							"example": "{\n  \"id\": \"a1b2c3d4-0000-4000-8000-000000000001\"\n}"
						}
					}
				},
				{
					"method": "DELETE",
					"path": "/environments/{env_id}",
					"name": "Delete environment",
					"description": "Удаляет окружение и относящуюся к нему историю запросов.",
					"tags": ["admin", "destructive"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"204": {
							"label": "204 No Content",
							"schema": [],
							"example": ""
						}
					}
				}
			]
		},
		{
			"label": "Ingest",
			"endpoints": [
				{
					"method": "POST",
					"path": "/ingest/{service_slug}/requests",
					"name": "Ingest request record",
					"description": "Принимает одну запись истории (запрос + ответ) от сервиса-источника. Аутентификация — по ingest-токену сервиса (заголовок X-Ingest-Token). Идемпотентность обеспечивается по correlation_id.",
					"tags": ["ingest", "high-throughput"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "environment",
							"type": "string",
							"required": false,
							"desc": "Имя окружения источника (prod / staging / local)",
							"default": "prod"
						},
						{
							"name": "direction",
							"type": "string",
							"required": true,
							"desc": "Направление: inbound (сервис принял) или outbound (сервис отправил)",
							"default": "inbound"
						},
						{
							"name": "method",
							"type": "string",
							"required": true,
							"desc": "HTTP-метод",
							"default": ""
						},
						{
							"name": "url",
							"type": "string",
							"required": true,
							"desc": "Полный URL запроса",
							"default": ""
						},
						{
							"name": "request_headers",
							"type": "object",
							"required": false,
							"desc": "Заголовки запроса (секреты должны быть замаскированы)",
							"default": ""
						},
						{
							"name": "request_body",
							"type": "string",
							"required": false,
							"desc": "Тело запроса (raw). Большие тела сервис вынесет в Payload",
							"default": ""
						},
						{
							"name": "status_code",
							"type": "integer",
							"required": false,
							"desc": "HTTP-код ответа (отсутствует при ошибке соединения)",
							"default": ""
						},
						{
							"name": "response_headers",
							"type": "object",
							"required": false,
							"desc": "Заголовки ответа",
							"default": ""
						},
						{
							"name": "response_body",
							"type": "string",
							"required": false,
							"desc": "Тело ответа (raw)",
							"default": ""
						},
						{
							"name": "started_at",
							"type": "datetime",
							"required": true,
							"desc": "Время начала запроса (ISO 8601, UTC)",
							"default": ""
						},
						{
							"name": "duration_ms",
							"type": "integer",
							"required": false,
							"desc": "Длительность обмена в миллисекундах",
							"default": ""
						},
						{
							"name": "correlation_id",
							"type": "string",
							"required": false,
							"desc": "Идентификатор для дедупликации и трассировки",
							"default": ""
						},
						{
							"name": "error_kind",
							"type": "string",
							"required": false,
							"desc": "Тип ошибки: timeout / connection / tls / ... (если запрос не удался)",
							"default": ""
						}
					],
					"responses": {
						"202": {
							"label": "202 Accepted",
							"schema": [
								{
									"key": "id",
									"type": "uuid",
									"desc": "UUID созданной записи истории",
									"example": "\"b2c3d4e5-1111-4111-8111-111111111111\""
								},
								{
									"key": "deduplicated",
									"type": "boolean",
									"desc": "true, если запись с таким correlation_id уже была принята",
									"example": "false"
								}
							],
							"example": "{\n  \"id\": \"b2c3d4e5-1111-4111-8111-111111111111\",\n  \"deduplicated\": false\n}"
						},
						"401": {
							"label": "401 Unauthorized",
							"schema": [
								{
									"key": "message",
									"type": "string",
									"desc": "Описание ошибки"
								}
							],
							"example": "{\n  \"message\": \"Invalid ingest token\"\n}"
						}
					}
				},
				{
					"method": "POST",
					"path": "/ingest/{service_slug}/requests:batch",
					"name": "Ingest batch",
					"description": "Пакетный приём истории — массив записей того же формата, что и одиночный ingest. Используется агентами/прокси для снижения числа обращений.",
					"tags": ["ingest", "high-throughput"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "records",
							"type": "array",
							"required": true,
							"desc": "Массив записей истории (см. Ingest request record)",
							"default": ""
						}
					],
					"responses": {
						"202": {
							"label": "202 Accepted",
							"schema": [
								{
									"key": "accepted",
									"type": "integer",
									"desc": "Сколько записей принято",
									"example": "98"
								},
								{
									"key": "deduplicated",
									"type": "integer",
									"desc": "Сколько отброшено как дубли",
									"example": "2"
								}
							],
							"example": "{\n  \"accepted\": 98,\n  \"deduplicated\": 2\n}"
						}
					}
				}
			]
		},
		{
			"label": "History",
			"endpoints": [
				{
					"method": "GET",
					"path": "/services/{id}/requests",
					"name": "Query request history",
					"description": "Возвращает историю запросов сервиса с фильтрами и пагинацией. Тела по умолчанию не возвращаются (только метаданные) — за телом обращайтесь к payload-эндпоинту.",
					"tags": ["paginated", "auth-required"],
					"auth": true,
					"queryParams": [
						{
							"name": "environment",
							"type": "string",
							"required": false,
							"desc": "Фильтр по окружению",
							"default": ""
						},
						{
							"name": "method",
							"type": "string",
							"required": false,
							"desc": "Фильтр по HTTP-методу",
							"default": ""
						},
						{
							"name": "status_code",
							"type": "integer",
							"required": false,
							"desc": "Фильтр по коду ответа",
							"default": ""
						},
						{
							"name": "endpoint_id",
							"type": "uuid",
							"required": false,
							"desc": "Фильтр по нормализованному эндпоинту",
							"default": ""
						},
						{
							"name": "direction",
							"type": "string",
							"required": false,
							"desc": "inbound / outbound",
							"default": ""
						},
						{
							"name": "correlation_id",
							"type": "string",
							"required": false,
							"desc": "Поиск по идентификатору трассировки",
							"default": ""
						},
						{
							"name": "from",
							"type": "datetime",
							"required": false,
							"desc": "Начало интервала (started_at >= from)",
							"default": ""
						},
						{
							"name": "to",
							"type": "datetime",
							"required": false,
							"desc": "Конец интервала (started_at < to)",
							"default": ""
						},
						{
							"name": "limit",
							"type": "integer",
							"required": false,
							"desc": "Элементов на странице",
							"default": "50"
						},
						{
							"name": "cursor",
							"type": "string",
							"required": false,
							"desc": "Курсор пагинации (keyset по started_at)",
							"default": ""
						}
					],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{ "key": "data[].id", "type": "uuid", "desc": "UUID записи" },
								{
									"key": "data[].method",
									"type": "string",
									"desc": "HTTP-метод"
								},
								{
									"key": "data[].path",
									"type": "string",
									"desc": "Путь запроса"
								},
								{
									"key": "data[].status_code",
									"type": "integer",
									"desc": "Код ответа"
								},
								{
									"key": "data[].duration_ms",
									"type": "integer",
									"desc": "Длительность"
								},
								{
									"key": "data[].started_at",
									"type": "datetime",
									"desc": "Время начала"
								},
								{
									"key": "next_cursor",
									"type": "string",
									"desc": "Курсор следующей страницы (null в конце)"
								}
							],
							"example": "{\n  \"data\": [\n    { \"id\": \"b2c3d4e5-1111-4111-8111-111111111111\", \"method\": \"POST\", \"path\": \"/v1/charges\", \"status_code\": 201, \"duration_ms\": 142, \"started_at\": \"2026-06-05T10:15:00Z\" }\n  ],\n  \"next_cursor\": \"eyJ0cyI6IjIwMjYtMDYtMDVUMTA6MTU6MDBaIn0\"\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/requests/{request_id}",
					"name": "Get request record",
					"description": "Возвращает полную запись истории: метаданные запроса и ответа, заголовки и ссылки на тела (payload).",
					"tags": ["auth-required"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
