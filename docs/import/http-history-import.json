					"desc": "Ключ объекта в blob-хранилище (S3/MinIO)",
					"note": "null, если тело хранится inline",
					"example": "\"payloads/2026/06/05/c3d4e5f6.bin\""
				},
				{
					"name": "inline_body",
					"type": "string",
					"req": false,
					"nullable": true,
					"desc": "Тело прямо в БД для мелких payload",
					"note": "Используется при size ниже порога",
					"example": "\"{ \\\"amount\\\": 4200 }\""
				},
				{
					"name": "expires_at",
					"type": "datetime",
					"req": false,
					"nullable": true,
					"desc": "Когда тело будет удалено по retention-политике",
					"note": "ISO 8601, UTC",
					"example": "\"2026-07-05T10:15:00Z\""
				}
			]
		},
		{
			"name": "Endpoint",
			"desc": "Нормализованный шаблон пути сервиса (например, /users/:id). Группирует записи истории для фильтрации и агрегатов.",
			"fields": [
				{
					"name": "id",
					"type": "uuid",
					"req": true,
					"nullable": false,
					"desc": "UUID эндпоинта",
					"note": "UUIDv4",
					"example": "\"e5f6a7b8-4444-4444-8444-444444444444\""
				},
				{
					"name": "service_id",
					"type": "uuid",
					"req": true,
					"nullable": false,
					"desc": "Ссылка на сервис",
					"note": "FK → Service.id",
					"example": "\"7c9e6679-7425-40de-944b-e07fc1f90ae7\""
				},
				{
					"name": "method",
					"type": "string",
					"req": true,
					"nullable": false,
					"desc": "HTTP-метод шаблона",
					"note": "",
					"example": "\"POST\""
				},
				{
					"name": "path_template",
					"type": "string",
					"req": true,
					"nullable": false,
					"desc": "Шаблон пути с плейсхолдерами",
					"note": "Уникален в паре (service_id, method, path_template)",
					"example": "\"/v1/charges\""
				},
				{
					"name": "created_at",
					"type": "datetime",
					"req": true,
					"nullable": false,
					"desc": "Когда шаблон впервые встретился",
					"note": "ISO 8601, UTC",
					"example": "\"2026-01-12T11:00:00Z\""
				}
			]
		},
		{
			"name": "IngestToken",
			"desc": "Токен для аутентификации приёма истории конкретного сервиса. Передаётся агентом в заголовке X-Ingest-Token.",
			"fields": [
				{
					"name": "id",
					"type": "uuid",
					"req": true,
					"nullable": false,
					"desc": "UUID токена",
					"note": "UUIDv4",
					"example": "\"f6a7b8c9-5555-4555-8555-555555555555\""
				},
				{
					"name": "service_id",
					"type": "uuid",
					"req": true,
					"nullable": false,
					"desc": "Ссылка на сервис",
					"note": "FK → Service.id",
					"example": "\"7c9e6679-7425-40de-944b-e07fc1f90ae7\""
				},
				{
					"name": "name",
					"type": "string",
					"req": true,
					"nullable": false,
					"desc": "Назначение токена",
					"note": "",
					"example": "\"prod-agent\""
				},
				{
					"name": "token_hash",
					"type": "string",
					"req": true,
					"nullable": false,
					"desc": "Хеш секретного значения (само значение не хранится)",
					"note": "SHA-256/argon2",
					"example": "\"$argon2id$v=19$m=65536...\""
				},
				{
					"name": "prefix",
					"type": "string",
					"req": true,
					"nullable": false,
					"desc": "Первые символы токена для опознания в UI",
					"note": "",
					"example": "\"ihs_a1b2\""
				},
				{
					"name": "last_used_at",
					"type": "datetime",
					"req": false,
					"nullable": true,
					"desc": "Время последнего использования",
					"note": "ISO 8601, UTC",
					"example": "\"2026-06-05T10:14:59Z\""
				},
				{
					"name": "revoked",
					"type": "boolean",
					"req": true,
					"nullable": false,
					"desc": "Отозван ли токен",
					"note": "true → ingest отклоняется",
					"example": "false"
				}
			]
		},
		{
			"name": "Tag",
			"desc": "Произвольная метка для записей истории (например, инцидент или релиз). Связь с RequestRecord — многие-ко-многим.",
			"fields": [
				{
					"name": "id",
					"type": "uuid",
					"req": true,
					"nullable": false,
					"desc": "UUID метки",
					"note": "UUIDv4",
					"example": "\"a7b8c9d0-6666-4666-8666-666666666666\""
				},
				{
					"name": "service_id",
					"type": "uuid",
					"req": true,
					"nullable": false,
					"desc": "Ссылка на сервис",
					"note": "FK → Service.id",
					"example": "\"7c9e6679-7425-40de-944b-e07fc1f90ae7\""
				},
				{
					"name": "key",
					"type": "string",
					"req": true,
					"nullable": false,
					"desc": "Имя метки",
					"note": "Уникально в паре (service_id, key)",
					"example": "\"incident-4821\""
				}
			]
		}
	],
	"environments": [
		{
			"env": "prod",
			"label": "Production",
			"baseUrl": "https://history.internal",
			"prefix": "/api/v1",
			"value": [{ "name": "INGEST_TOKEN", "value": "ihs_prod-token-here" }],
			"accessToken": null
		},
