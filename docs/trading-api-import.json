{
	"doc": {
		"name": "Sleipnir Trading API",
		"version": "v1",
		"desc": "REST API торгового сервиса Sleipnir, используемый фронтендом через axiosClientTreding (baseURL: <centralManager>/api/trading/v1). Включает рыночные данные для графиков (TradingView Datafeed), управление ордерами, позициями и торговыми аккаунтами. Все эндпоинты требуют JWT (Bearer-заголовок Authorization, добавляется автоматически интерсептором; при 401 выполняется refresh токена).",
		"tags": ["REST", "JSON", "JWT", "Trading"]
	},
	"groups": [
		{
			"label": "Market Data",
			"endpoints": [
				{
					"method": "GET",
					"path": "/time",
					"name": "Server time",
					"description": "Возвращает текущее серверное время (Unix-метка). Используется TradingView Datafeed (getServerTimeApi).",
					"tags": ["chart"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "time",
									"type": "integer",
									"desc": "Серверное время (Unix timestamp, секунды)",
									"example": "1740394800"
								}
							],
							"example": "{\n  \"time\": 1740394800\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/config",
					"name": "Datafeed config",
					"description": "Возвращает конфигурацию TradingView Datafeed (поддерживаемые интервалы, типы биржи и т. п.). Используется getChartConfigApi.",
					"tags": ["chart"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "supported_resolutions",
									"type": "array",
									"desc": "Поддерживаемые таймфреймы",
									"example": "[\"1\",\"5\",\"15\",\"60\",\"1D\"]"
								},
								{
									"key": "supports_group_request",
									"type": "boolean",
									"desc": "Поддержка групповых запросов символов",
									"example": "false"
								},
								{
									"key": "supports_marks",
									"type": "boolean",
									"desc": "Поддержка меток на графике",
									"example": "false"
								},
								{
									"key": "supports_search",
									"type": "boolean",
									"desc": "Поддержка поиска символов",
									"example": "true"
								},
								{
									"key": "supports_timescale_marks",
									"type": "boolean",
									"desc": "Поддержка меток на шкале времени",
									"example": "false"
								}
							],
							"example": "{\n  \"supported_resolutions\": [\"1\", \"5\", \"15\", \"60\", \"240\", \"1D\"],\n  \"supports_group_request\": false,\n  \"supports_marks\": false,\n  \"supports_search\": true,\n  \"supports_timescale_marks\": false\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/search",
					"name": "Search symbols",
					"description": "Поиск торговых символов для TradingView (searchSymbolsApi). Возвращает массив подходящих инструментов.",
					"tags": ["chart"],
					"auth": true,
					"queryParams": [
						{
							"name": "query",
							"type": "string",
							"required": false,
							"desc": "Строка поиска (тикер или название)",
							"default": ""
						},
						{
							"name": "exchange",
							"type": "string",
							"required": false,
							"desc": "Фильтр по бирже",
							"default": ""
						},
						{
							"name": "type",
							"type": "string",
							"required": false,
							"desc": "Фильтр по типу инструмента",
							"default": ""
						},
						{
							"name": "limit",
							"type": "integer",
							"required": false,
							"desc": "Максимальное число результатов",
							"default": ""
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "[].symbol",
									"type": "string",
									"desc": "Тикер символа",
									"example": "\"BTCUSDT\""
								},
								{
									"key": "[].full_name",
									"type": "string",
									"desc": "Полное имя (exchange:symbol)",
									"example": "\"BINANCE:BTCUSDT\""
								},
								{
									"key": "[].description",
									"type": "string",
									"desc": "Описание инструмента",
									"example": "\"Bitcoin / TetherUS Perpetual\""
								},
								{
									"key": "[].exchange",
									"type": "string",
									"desc": "Биржа",
									"example": "\"binance_futures\""
								},
								{
									"key": "[].type",
									"type": "string",
									"desc": "Тип инструмента",
									"example": "\"crypto\""
								}
							],
							"example": "[\n  {\n    \"symbol\": \"BTCUSDT\",\n    \"full_name\": \"BINANCE:BTCUSDT\",\n    \"description\": \"Bitcoin / TetherUS Perpetual\",\n    \"exchange\": \"binance_futures\",\n    \"type\": \"crypto\"\n  }\n]"
						}
					}
				},
				{
					"method": "GET",
					"path": "/symbols/{symbol}",
					"name": "Get symbol info",
					"description": "Возвращает описание символа в формате TradingView LibrarySymbolInfo (getSymbolApi).",
					"tags": ["chart"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "name",
									"type": "string",
									"desc": "Имя символа",
									"example": "\"BTCUSDT\""
								},
								{
									"key": "full_name",
									"type": "string",
									"desc": "Полное имя",
									"example": "\"BINANCE:BTCUSDT\""
								},
								{
									"key": "description",
									"type": "string",
									"desc": "Описание",
									"example": "\"Bitcoin / TetherUS\""
								},
								{
									"key": "exchange",
									"type": "string",
									"desc": "Биржа",
									"example": "\"binance_futures\""
								},
								{
									"key": "type",
									"type": "string",
									"desc": "Тип инструмента",
									"example": "\"crypto\""
								},
								{
									"key": "session",
									"type": "string",
									"desc": "Торговая сессия",
									"example": "\"24x7\""
								},
								{
									"key": "timezone",
									"type": "string",
									"desc": "Часовой пояс",
									"example": "\"Etc/UTC\""
								},
								{
									"key": "pricescale",
									"type": "integer",
									"desc": "Масштаб цены",
									"example": "100"
								},
								{
									"key": "minmov",
									"type": "integer",
									"desc": "Минимальный шаг цены",
									"example": "1"
								},
								{
									"key": "supported_resolutions",
									"type": "array",
									"desc": "Поддерживаемые таймфреймы",
									"example": "[\"1\",\"5\",\"60\",\"1D\"]"
								}
							],
							"example": "{\n  \"name\": \"BTCUSDT\",\n  \"full_name\": \"BINANCE:BTCUSDT\",\n  \"description\": \"Bitcoin / TetherUS\",\n  \"exchange\": \"binance_futures\",\n  \"type\": \"crypto\",\n  \"session\": \"24x7\",\n  \"timezone\": \"Etc/UTC\",\n  \"pricescale\": 100,\n  \"minmov\": 1,\n  \"supported_resolutions\": [\"1\", \"5\", \"15\", \"60\", \"240\", \"1D\"]\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/klines",
					"name": "Get klines",
					"description": "Возвращает исторические свечи (klines) для построения графика (getKlinesApi). Фронтенд преобразует их в TradingView Bar[].",
					"tags": ["chart"],
					"auth": true,
					"queryParams": [
						{
							"name": "exchange",
							"type": "string",
							"required": true,
							"desc": "Биржа",
							"default": ""
						},
						{
							"name": "symbol",
							"type": "string",
							"required": true,
							"desc": "Торговая пара",
							"default": ""
						},
						{
							"name": "interval",
							"type": "string",
							"required": true,
							"desc": "Таймфрейм (например, 1m, 5m, 1h)",
							"default": ""
						},
						{
							"name": "from",
							"type": "integer",
							"required": true,
							"desc": "Начало диапазона (Unix timestamp)",
							"default": ""
						},
						{
							"name": "to",
							"type": "integer",
							"required": true,
							"desc": "Конец диапазона (Unix timestamp)",
							"default": ""
						},
						{
							"name": "limit",
							"type": "integer",
							"required": false,
							"desc": "Максимальное число свечей",
							"default": ""
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "klines[].open_time",
									"type": "integer",
									"desc": "Время открытия свечи (Unix timestamp)",
									"example": "1740394800"
								},
								{
									"key": "klines[].close_time",
									"type": "integer",
									"desc": "Время закрытия свечи (Unix timestamp)",
									"example": "1740394859"
								},
								{
									"key": "klines[].open",
									"type": "string",
									"desc": "Цена открытия",
									"example": "\"65000.0\""
								},
								{
									"key": "klines[].high",
									"type": "string",
									"desc": "Максимальная цена",
									"example": "\"65100.0\""
								},
								{
									"key": "klines[].low",
									"type": "string",
									"desc": "Минимальная цена",
									"example": "\"64950.0\""
								},
								{
									"key": "klines[].close",
									"type": "string",
									"desc": "Цена закрытия",
									"example": "\"65050.0\""
								},
								{
									"key": "klines[].volume",
									"type": "string",
									"desc": "Объём",
									"example": "\"12.345\""
								}
							],
							"example": "{\n  \"klines\": [\n    {\n      \"open_time\": 1740394800,\n      \"close_time\": 1740394859,\n      \"open\": \"65000.0\",\n      \"high\": \"65100.0\",\n      \"low\": \"64950.0\",\n      \"close\": \"65050.0\",\n      \"volume\": \"12.345\"\n    }\n  ]\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/instruments",
					"name": "List instruments",
					"description": "Возвращает список торговых инструментов биржи (getSymbols). Используется для построения списка символов и торговых параметров.",
					"tags": ["chart"],
					"auth": true,
					"queryParams": [
						{
							"name": "exchange",
							"type": "string",
							"required": true,
							"desc": "Биржа",
							"default": ""
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "instruments[]",
									"type": "object",
									"desc": "Инструмент (см. сущность Instrument)"
								}
							],
							"example": "{\n  \"instruments\": [\n    {\n      \"exchange\": \"binance_futures\",\n      \"section\": \"PERPETUAL\",\n      \"symbol\": \"BTCUSDT\",\n      \"exchange_symbol\": \"BTCUSDT\",\n      \"base\": \"BTC\",\n      \"quote\": \"USDT\",\n      \"status\": \"TRADING\",\n      \"price_tick\": \"0.1\",\n      \"qty_step\": \"0.001\",\n      \"price_decimals\": 1,\n      \"qty_decimals\": 3,\n      \"min_qty\": \"0.001\",\n      \"min_notional\": \"5\",\n      \"max_leverage\": 125\n    }\n  ]\n}"
						}
					}
				}
			]
		},
		{
			"label": "Orders",
			"endpoints": [
				{
					"method": "GET",
					"path": "/orders",
					"name": "List orders",
					"description": "Возвращает открытые ордера по торговому аккаунту и бирже (getOrdersApi).",
					"tags": ["trading"],
					"auth": true,
					"queryParams": [
						{
							"name": "key_id",
							"type": "string",
							"required": true,
							"desc": "ID торгового аккаунта (API-ключа)",
							"default": ""
						},
						{
							"name": "exchange",
							"type": "string",
							"required": true,
							"desc": "Биржа",
							"default": ""
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "orders[]",
									"type": "object",
									"desc": "Ордер (см. сущность Order)"
								}
							],
							"example": "{\n  \"orders\": [\n    {\n      \"order_id\": \"6a1b...\",\n      \"exchange_order_id\": \"123456789\",\n      \"exchange\": \"binance_futures\",\n      \"symbol\": \"BTCUSDT\",\n      \"status\": \"NEW\",\n      \"side\": \"BUY\",\n      \"type\": \"LIMIT\",\n      \"qty\": \"0.01\",\n      \"filled_qty\": \"0\",\n      \"price\": \"64000.0\",\n      \"avg_fill_price\": null,\n      \"stop_price\": null,\n      \"tif\": \"GTC\",\n      \"post_only\": false,\n      \"reduce_only\": false,\n      \"created_at\": \"2026-02-24T12:00:00Z\",\n      \"updated_at\": \"2026-02-24T12:00:00Z\"\n    }\n  ]\n}"
						}
					}
				},
				{
					"method": "POST",
					"path": "/orders",
					"name": "Create order",
					"description": "Создаёт ордер. Один эндпоинт для лимитных (createOrderLimitApi, type=LIMIT) и рыночных (createOrderMarketApi, type=MARKET) ордеров. Для рыночных ордеров поля price/tif/post_only не передаются.",
					"tags": ["trading"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "exchange",
							"type": "string",
							"required": true,
							"desc": "Биржа",
							"default": ""
						},
						{
							"name": "section",
							"type": "string",
							"required": true,
							"desc": "Секция рынка (всегда PERPETUAL)",
							"default": "PERPETUAL"
						},
						{
							"name": "symbol",
							"type": "string",
							"required": true,
							"desc": "Торговая пара",
							"default": ""
						},
						{
							"name": "key_id",
							"type": "string",
							"required": true,
							"desc": "ID торгового аккаунта (API-ключа)",
							"default": ""
						},
						{
							"name": "client_order_id",
							"type": "string",
							"required": true,
							"desc": "Клиентский идентификатор ордера",
							"default": ""
						},
						{
							"name": "side",
							"type": "string",
							"required": true,
							"desc": "Направление: BUY или SELL",
							"default": ""
						},
						{
							"name": "type",
							"type": "string",
							"required": true,
							"desc": "Тип ордера: LIMIT или MARKET",
							"default": ""
						},
						{
							"name": "qty",
							"type": "string",
							"required": true,
							"desc": "Объём",
							"default": ""
						},
						{
							"name": "price",
							"type": "string",
							"required": false,
							"desc": "Цена (только для LIMIT)",
							"default": ""
						},
						{
							"name": "tif",
							"type": "string",
							"required": false,
							"desc": "Time in force: GTC, IOC, FOK, GTX (только для LIMIT)",
							"default": ""
						},
						{
							"name": "post_only",
							"type": "boolean",
							"required": false,
							"desc": "Только мейкер (только для LIMIT)",
							"default": "false"
						},
						{
							"name": "reduce_only",
							"type": "boolean",
							"required": false,
							"desc": "Только уменьшение позиции",
							"default": "false"
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "order_id",
									"type": "string",
									"desc": "Внутренний ID ордера"
								},
								{
									"key": "exchange_order_id",
									"type": "string",
									"desc": "ID ордера на бирже"
								},
								{
									"key": "status",
									"type": "string",
									"desc": "Статус ордера",
									"example": "\"NEW\""
								}
							],
							"example": "{\n  \"order_id\": \"6a1b...\",\n  \"exchange_order_id\": \"123456789\",\n  \"exchange\": \"binance_futures\",\n  \"symbol\": \"BTCUSDT\",\n  \"status\": \"NEW\",\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"qty\": \"0.01\",\n  \"filled_qty\": \"0\",\n  \"price\": \"64000.0\",\n  \"avg_fill_price\": null,\n  \"stop_price\": null,\n  \"tif\": \"GTC\",\n  \"post_only\": false,\n  \"reduce_only\": false,\n  \"created_at\": \"2026-02-24T12:00:00Z\",\n  \"updated_at\": \"2026-02-24T12:00:00Z\"\n}"
						}
					}
				},
				{
					"method": "GET",
					"path": "/orders/{orderId}",
					"name": "Get order",
					"description": "Возвращает ордер по ID (getOrderApi).",
					"tags": ["trading"],
					"auth": true,
					"queryParams": [
						{
							"name": "exchange",
							"type": "string",
							"required": true,
							"desc": "Биржа",
							"default": ""
						},
						{
							"name": "symbol",
							"type": "string",
							"required": true,
							"desc": "Торговая пара",
							"default": ""
						},
						{
							"name": "key_id",
							"type": "string",
							"required": true,
							"desc": "ID торгового аккаунта (API-ключа)",
							"default": ""
						},
						{
							"name": "section",
							"type": "string",
							"required": false,
							"desc": "Секция рынка",
							"default": ""
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "order_id",
									"type": "string",
									"desc": "Ордер (см. сущность Order)"
								}
							],
							"example": "{\n  \"order_id\": \"6a1b...\",\n  \"exchange_order_id\": \"123456789\",\n  \"exchange\": \"binance_futures\",\n  \"symbol\": \"BTCUSDT\",\n  \"status\": \"PARTIALLY_FILLED\",\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"qty\": \"0.01\",\n  \"filled_qty\": \"0.004\",\n  \"price\": \"64000.0\",\n  \"avg_fill_price\": \"63990.0\",\n  \"stop_price\": null,\n  \"tif\": \"GTC\",\n  \"created_at\": \"2026-02-24T12:00:00Z\",\n  \"updated_at\": \"2026-02-24T12:01:00Z\"\n}"
						}
					}
				},
				{
					"method": "PATCH",
					"path": "/orders/{orderId}",
					"name": "Update order",
					"description": "Изменяет цену и/или объём существующего ордера (updateOrderApi).",
					"tags": ["trading"],
					"auth": true,
					"queryParams": [],
					"bodyParams": [
						{
							"name": "exchange",
							"type": "string",
							"required": true,
							"desc": "Биржа",
							"default": ""
						},
						{
							"name": "symbol",
							"type": "string",
							"required": true,
							"desc": "Торговая пара",
							"default": ""
						},
						{
							"name": "key_id",
							"type": "string",
							"required": true,
							"desc": "ID торгового аккаунта (API-ключа)",
							"default": ""
						},
						{
							"name": "price",
							"type": "string",
							"required": true,
							"desc": "Новая цена",
							"default": ""
						},
						{
							"name": "qty",
							"type": "string",
							"required": true,
							"desc": "Новый объём",
							"default": ""
						},
						{
							"name": "section",
							"type": "string",
							"required": true,
							"desc": "Секция рынка (всегда PERPETUAL)",
							"default": "PERPETUAL"
						}
					],
					"responses": {
						"200": {
							"label": "200 OK",
							"schema": [
								{
									"key": "order_id",
									"type": "string",
									"desc": "Обновлённый ордер (см. сущность Order)"
